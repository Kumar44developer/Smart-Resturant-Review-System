# Copy to .env and adjust. Real environment variables take precedence over this file.
# All values below are safe defaults for LOCAL demo use.

# --- Runtime ---
APP_ENV=dev                         # "prod" disables /dev/seed-demo and verbose logging
SECRET_KEY=dev-insecure-secret-change-me   # use a random >=32-byte value in production
DATABASE_PATH=./data/app.db         # SQLite file (stdlib; no native driver)

# --- AI provider (replaceable) ---
# demo  = deterministic local NLP pipeline (no network, no key) -> sets demo_mode=true
# openai_compat = hosted OpenAI-compatible endpoint (e.g. Groq) — requires AI_API_KEY
AI_PROVIDER=demo
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_CHAT_MODEL=llama-3.3-70b-versatile
AI_EMBEDDING_MODEL=                 # set to use hosted embeddings; else hashing is used
AI_TIMEOUT_SECONDS=30

# --- Web / limits ---
CORS_ORIGINS=http://localhost:8000
RATE_LIMIT_PER_MIN=120
MAX_UPLOAD_MB=5
MAX_REQUEST_BYTES=1048576
JWT_EXPIRY_MINUTES=720

# --- Optional SMTP (notifications are not auto-sent; reserved) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
