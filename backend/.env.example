# Copy to .env and fill in real values. Never commit .env.
# --- App ---
APP_ENV=dev
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_PATH=./data/app.db
JWT_EXPIRY_MINUTES=720

# --- Frontend/CORS ---
CORS_ORIGINS=http://localhost:8000

# --- AI provider ---
# AI_PROVIDER=demo uses the deterministic, clearly-labeled local provider (no key needed).
# AI_PROVIDER=openai_compat talks to any OpenAI-compatible endpoint (e.g. Groq) when AI_API_KEY is set.
AI_PROVIDER=demo
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_CHAT_MODEL=llama-3.3-70b-versatile
AI_EMBEDDING_MODEL=
AI_TIMEOUT_SECONDS=30

# --- Limits / security ---
MAX_UPLOAD_MB=5
RATE_LIMIT_PER_MIN=120
MAX_REQUEST_BYTES=1048576

# --- Optional email delivery for weekly digests (leave blank to use in-app/export only) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
